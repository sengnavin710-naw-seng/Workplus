# Local-only placeholders. Replace every value before running the application.
DATABASE_URL=postgresql://username:password@localhost:5432/workforce_platform
BETTER_AUTH_SECRET=replace-with-a-secure-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google OAuth. Leave both unset to disable the Google sign-in button.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Optional email-code sign-in delivery. Configure both values together.
# RESEND_API_KEY=replace-with-your-resend-api-key
# AUTH_EMAIL_FROM="WorkPlus <no-reply@your-domain.example>"
