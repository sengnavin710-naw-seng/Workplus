{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workforce Platform Agent",
  "version": "0.0.0",
  "identifier": "com.workforceplatform.agent",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workforce Platform Agent",
        "width": 720,
        "height": 620,
        "minWidth": 460,
        "minHeight": 520,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
