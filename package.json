{
  "name": "workforce-platform",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write .",
    "auth:bootstrap-owner": "bun --filter @repo/auth bootstrap-owner",
    "db:push": "bun --filter @repo/db db:push",
    "db:repair-employee-access": "bun --filter @repo/db repair-employee-access",
    "db:studio": "bun --filter @repo/db db:studio"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "6.0.3"
  }
}
